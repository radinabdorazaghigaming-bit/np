{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "np",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "558e9469-d23e-4d0a-8b07-0c2944188743","database_name": "nova-proxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "85f9131da5dd4acda31d957614b88fea" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
